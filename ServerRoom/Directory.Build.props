<Project>
  <!--
    Client half of the Server Room background, vendored from amos's Server Room Background
    (https://github.com/14amos/ServerRoomBackground, MIT, see LICENSE.txt in this folder).
    Built by the root UnlockAllBackgrounds.csproj; SPTPath is passed down from it.
  -->
  <PropertyGroup>
    <SPTPath Condition="'$(SPTPath)' == ''">$(SPT_PATH)</SPTPath>
    <SPTPath Condition="'$(SPTPath)' != ''">$(SPTPath.TrimEnd('\'))</SPTPath>
    <Version>1.0.1</Version>
    <Authors>amos, Joel</Authors>
    <Copyright>Server Room Background code Copyright (c) 2026 amos, MIT License</Copyright>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PathMap>$(MSBuildThisFileDirectory)=./</PathMap>
  </PropertyGroup>
</Project>
